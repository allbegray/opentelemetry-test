<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <appender name="OpenTelemetry" class="io.opentelemetry.instrumentation.logback.appender.v1_0.OpenTelemetryAppender">
        <!--
          [운영 필수] 1. captureMdcAttributes (기본값: 미설정)
             - MDC(Mapped Diagnostic Context)에 저장된 사용자ID, 주문번호, 트랜잭션 문맥 키-값을 로그 속성으로 추출합니다.
             - 분산 추적 및 사용자 요청 흐름 분석에 필수적입니다.
        -->
        <captureMdcAttributes>*</captureMdcAttributes>

        <!--
          2. captureCodeAttributes (기본값: false)
             - 로그 호출 소스 위치(파일명, 클래스명, 메서드명, 줄번호)를 캡처합니다.
             - 주의: 매 로그마다 스택 추적(Stack Walker)을 수행하므로 고부하 운영 환경에서는 CPU 오버헤드가 발생할 수 있어 기본값 false 권장.
        -->
        <captureCodeAttributes>false</captureCodeAttributes>

        <!--
          3. captureKeyValuePairAttributes (기본값: false)
             - SLF4J 2.0+ Fluent API(log.atInfo().addKeyValue(...))의 키-값 쌍 캡처.
        -->
        <captureKeyValuePairAttributes>false</captureKeyValuePairAttributes>

        <!--
          4. captureArguments (기본값: false)
             - 로거 호출 시 전달된 포맷 인자(Arguments) 목록을 별도 속성으로 캡처.
             - 로그 본문(body)에 이미 포함되어 포맷팅되므로 대역폭/저장공간 절약을 위해 기본값 false 권장.
        -->
        <captureArguments>false</captureArguments>

        <!--
          5. captureMarkerAttribute (기본값: false)
             - SLF4J Marker 객체 사용 시 마커 이름 캡처.
        -->
        <captureMarkerAttribute>false</captureMarkerAttribute>

        <!--
          6. captureLoggerContext (기본값: false)
             - Logback LoggerContext 전역 속성 캡처.
        -->
        <captureLoggerContext>false</captureLoggerContext>

        <!--
          7. captureLogstashAttributes (기본값: false)
             - Logstash Logback Marker 구조화 필드 캡처.
        -->
        <captureLogstashAttributes>false</captureLogstashAttributes>

        <!--
          8. captureExperimentalAttributes (기본값: false)
             - OpenTelemetry 시맨틱 컨벤션의 실험적(thread.name, thread.id 등) 속성 캡처.
        -->
        <captureExperimentalAttributes>false</captureExperimentalAttributes>

        <!--
          [운영 권장] 9. numLogsCapturedBeforeOtelInstall (기본값: 1000)
             - Spring Boot 부팅 극초기 로그를 보관해두는 버퍼 큐 크기.
             - OpenTelemetry 연동 완료 후 부팅 로그를 일괄 전송(Replay)하여 초기 에러 유실을 방지합니다.
        -->
        <numLogsCapturedBeforeOtelInstall>1000</numLogsCapturedBeforeOtelInstall>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="OpenTelemetry"/>
    </root>
</configuration>
